{
  "name": "damienmulhall",
  "version": "1.0.0",
  "description": "Damien Mulhall — project manager portfolio. Static site built with Eleventy.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npm-run-all --parallel dev:*",
    "dev:eleventy": "eleventy --serve --quiet",
    "dev:css": "node tools/build-css.mjs --watch",
    "dev:js": "node tools/build-js.mjs --watch",
    "build": "npm-run-all build:clean build:css build:js build:eleventy",
    "build:clean": "rimraf _site",
    "build:css": "node tools/build-css.mjs",
    "build:js": "node tools/build-js.mjs",
    "build:eleventy": "eleventy",
    "migrate": "node tools/migrate-wp.mjs",
    "lighthouse": "node tools/lighthouse.mjs",
    "smoke": "node tools/smoke.mjs"
  },
  "devDependencies": {
    "chrome-launcher": "^1.1.2",
    "csv-parse": "^5.6.0",
    "http-server": "^14.1.1",
    "lighthouse": "^12.8.2",
    "puppeteer-core": "^24.0.0",
    "turndown": "^7.2.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^6.0.1",
    "@11ty/eleventy-plugin-rss": "^2.0.2",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "esbuild": "^0.24.2",
    "gsap": "^3.13.0",
    "html-minifier-terser": "^7.2.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "sass": "^1.83.4",
    "tailwindcss": "^3.4.17"
  }
}
