{#
  Highlight badges — port of parts/highlights-badges.php
  `keys` is an array of keys into the `badgeStyles` global data file.
  `size` is 'small' (default) or 'medium'. Maximum of three badges render.

  `styles` is the `badgeStyles` global, passed in explicitly:
    {% from "partials/highlights-badges.njk" import badges %}
    {{ badges(item.data.highlights, 'small', badgeStyles) }}
#}
{% macro badges(keys, size, styles) %}
{%- if keys and keys.length -%}
{%- set containerClass = "w-20 h-20 lg:w-24 lg:h-24" if size == "medium" else "w-16 h-16 lg:w-20 lg:h-20" -%}
{%- set iconClass = "w-12 h-12 lg:w-14 lg:h-14" if size == "medium" else "w-8 h-8 lg:w-10 lg:h-10" -%}
    <div class="flex gap-3 mt-4 md:mt-0">
        {%- for key in keys -%}
        {%- if loop.index <= 3 -%}
        {%- set highlight = styles[key] -%}
        {%- if highlight -%}
        {%- set color = highlight.color or "#201a1e" -%}
        {%- set needsInvert = color != "#e1dfd0" and color != "#e3bf30" -%}
            <div
                class="{{ containerClass }} rounded-full flex items-center justify-center"
                style="background-color: {{ color }};"
                title="{{ highlight.name }}">
                {%- if highlight.icon %}
                    <img
                        src="/assets/icons/{{ highlight.icon }}"
                        alt="{{ highlight.name }}"
                        class="{{ iconClass }} object-contain"
                        style="{% if needsInvert %}filter: brightness(0) invert(1);{% endif %}"
                        loading="lazy">
                {%- endif %}
            </div>
        {%- endif -%}
        {%- endif -%}
        {%- endfor %}
    </div>
{%- endif -%}
{% endmacro %}
