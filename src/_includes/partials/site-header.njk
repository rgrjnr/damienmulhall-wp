                        <text x="63.6" y="35.6" fill="#33A199" font-family="'Neue Haas Grotesk Text', Helvetica, Arial, sans-serif" font-size="9.6">Project &amp; Product Manager, PMP</text>
                    </svg>
                </a>

                <!-- Menu -->
                <div class="hidden md:flex flex-row gap-8 items-center">
                    <ul class="nav-glide flex flex-row gap-8 items-center" data-nav-glide>
                        {%- for item in home.nav %}
                        {%- set isCurrent = item.url.endsWith('/') and page.url.startsWith(item.url) %}
                        <li><a href="{{ item.url }}"{% if isCurrent %} aria-current="page"{% endif %} class="font-haas-text font-bold text-body-sm text-dm-black hover:text-dm-cyan transition-colors">{{ item.label }}</a></li>
                        {%- endfor %}
                        <li class="nav-glide__bar" aria-hidden="true"></li>
                    </ul>
                </div>

                <!-- Mobile Menu Button -->
                <button class="md:hidden text-dm-black" id="mobile-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false">
                    <svg aria-hidden="true" focusable="false" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </nav>

            <!-- Mobile Menu Panel -->
            <div id="mobile-menu" class="md:hidden" aria-hidden="true">
                <ul class="flex flex-col gap-4 pb-6">
                    {%- for item in home.nav %}
                    {%- set isCurrent = item.url.endsWith('/') and page.url.startsWith(item.url) %}
                    <li><a href="{{ item.url }}"{% if isCurrent %} aria-current="page"{% endif %} class="font-haas-text font-bold text-body-lg text-dm-black hover:text-dm-cyan transition-colors">{{ item.label }}</a></li>
                    {%- endfor %}
                </ul>
            </div>

            <!-- Divider -->
            <div class="w-full h-[3px] bg-dm-black"></div>
        </div>

        {%- if showHero %}
        <!-- Hero Text -->
        <div class="flex flex-col lg:flex-row gap-12 lg:gap-28 items-start justify-between">
            <h1 data-hero-heading
                class="font-haas-display font-bold text-display-md lg:text-display-xl leading-none text-dm-black max-w-3xl">
                {%- if home.hero.highlight %}
                {{ home.hero.heading | escape | replace(home.hero.highlight, '<span class="scribble">' + home.hero.highlight + '</span>') | safe }}
                {%- else %}
                {{ home.hero.heading }}
                {%- endif %}
            </h1>
            <p class="font-haas-text font-medium text-body-md text-dm-black max-w-sm lg:pt-4">
                {{ home.hero.description }}
            </p>
        </div>

        <!-- Divider -->
        <div class="w-full h-[3px] bg-dm-black"></div>

        <!-- CTA Buttons -->
        <div class="flex flex-row gap-3.5 items-center justify-end">
            {{ button('Projects', '/#work', '', 'green', 'down') }}
        </div>

        <!-- Divider -->
        <div class="w-full h-[3px] bg-dm-black"></div>
        {%- endif %}
    </div>
</header>
