---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
    <title>{{ site.title }}</title>
    <subtitle>{{ site.description }}</subtitle>
    <link href="{{ '/feed.xml' | absoluteUrl(site.url) }}" rel="self"/>
    <link href="{{ site.url }}/"/>
    <updated>{{ collections.work | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
    <id>{{ site.url }}/</id>
    <author>
        <name>{{ site.author }}</name>
        <email>{{ site.email }}</email>
    </author>
    {%- for item in collections.work | reverse %}
    {%- set absolutePostUrl = item.url | absoluteUrl(site.url) %}
    <entry>
        <title>{{ item.data.title }}</title>
        <link href="{{ absolutePostUrl }}"/>
        <updated>{{ item.date | dateToRfc3339 }}</updated>
        <id>{{ absolutePostUrl }}</id>
        <summary>{{ item.data.excerpt }}</summary>
        <content type="html">{{ item.templateContent | htmlToAbsoluteUrls(absolutePostUrl) }}</content>
    </entry>
    {%- endfor %}
</feed>
