---
layout: layouts/base.njk
title: Selected work
description: Case studies from projects I've led end to end, from an AI startup's product and marketing to podcasts, community events and sales enablement for Dell Technologies.
permalink: /work/
showHero: false
eleventyExcludeFromCollections: true
---
{#
  Work index: one card per case study. The card headline is the case study's
  `outcome` (falls back to the title), the yellow badge is its first `stats`
  entry, and the tags are `labels` (falls back to the highlight badge names).
#}
<section class="w-full max-w-page mx-auto px-6 mt-section relative" aria-labelledby="work-title">
    <div class="border-b-[3px] border-dm-black pb-8">
        <h1 id="work-title" class="font-haas-display font-medium text-display-sm md:text-display-lg lg:text-display-xl text-dm-black leading-none">
            Selected work
        </h1>
    </div>

    {#- The filter row is hidden until lib/work-filter.ts wires it up, so without
        JS every card simply shows. #}
    <div class="work-filter" data-work-filter hidden>
        <p class="work-filter__label" id="work-filter-label">Show</p>
        <ul class="work-filter__list" aria-labelledby="work-filter-label">
            {%- for cat in ["All", "Events", "Sales enablement", "Content", "Product"] %}
            <li><button type="button" class="work-filter__button" data-filter="{{ cat }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ cat }}</button></li>
            {%- endfor %}
        </ul>
        <p class="sr-only" role="status" aria-live="polite" data-work-filter-status></p>
    </div>

    <ul class="work-grid">
        {%- asyncEach item in collections.work %}
        {%- set d = item.data %}
        {%- set thumb = d.thumb or d.hero %}
        {%- set stat = d.stats[0] if (d.stats and d.stats.length) else null %}
        <li data-categories="{{ (d.categories or []) | join('|') }}">
            <a class="work-card" href="{{ item.url }}">
                {%- if thumb %}
                <span class="work-card__image">
                    {% image thumb, "", { sizes: "(min-width: 1120px) 540px, (min-width: 768px) 50vw, 100vw" } %}
                    {%- if stat %}
                    <span class="work-card__stat">
                        <span class="work-card__stat-value">{{ stat.value }}</span>
                        <span class="work-card__stat-label">{{ stat.label }}</span>
                    </span>
                    {%- endif %}
                </span>
                {%- endif %}
                <span class="work-card__body">
                    {%- if d.client %}
                    <span class="work-card__eyebrow">{{ d.client }}</span>
                    {%- endif %}
                    <h2 class="work-card__title">{{ d.outcome or d.title }}</h2>
                    <p class="work-card__project">{{ (d.shortTitle or d.title) if d.outcome else d.excerpt }}</p>
                    {%- set tagList = d.labels if (d.labels and d.labels.length) else d.highlights %}
                    {%- if tagList and tagList.length %}
                    <ul class="work-card__tags" aria-label="Tags">
                        {%- for tag in tagList %}
                        {%- set tagName = tag if (d.labels and d.labels.length) else (badgeStyles[tag].name if badgeStyles[tag] else "") %}
                        {%- if tagName %}
                        <li class="work-card__tag">{{ tagName }}</li>
                        {%- endif %}
                        {%- endfor %}
                    </ul>
                    {%- endif %}
                </span>
            </a>
        </li>
        {%- endeach %}
    </ul>
</section>
