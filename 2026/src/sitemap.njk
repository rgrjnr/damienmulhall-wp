---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url>
        <loc>{{ '/' | absoluteUrl(site.url) }}</loc>
        <lastmod>{{ collections.work | getNewestCollectionItemDate | isoDate }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>1.0</priority>
    </url>
    <url>
        <loc>{{ '/work/' | absoluteUrl(site.url) }}</loc>
        <lastmod>{{ collections.work | getNewestCollectionItemDate | isoDate }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.8</priority>
    </url>
    {%- for item in collections.work %}
    <url>
        <loc>{{ item.url | absoluteUrl(site.url) }}</loc>
        <lastmod>{{ item.date | isoDate }}</lastmod>
        <changefreq>yearly</changefreq>
        <priority>0.7</priority>
    </url>
    {%- endfor %}
</urlset>
